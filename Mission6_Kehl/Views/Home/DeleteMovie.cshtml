@model Mission6_Kehl.Models.Movie

<h2>Are you sure you want to delete this movie?</h2>

<p><strong>Title:</strong> @Model.Title</p>
<p><strong>Year:</strong> @Model.Year</p>
<p><strong>Director:</strong> @Model.Director</p>

<form asp-action="ConfirmDelete" method="post">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="ViewMovies" class="btn btn-secondary">Cancel</a>
</form>
