@model Mission6_Kehl.Models.Movie

<h2>Edit Movie</h2>

<form asp-action="EditMovie" method="post">
    <input type="hidden" asp-for="MovieId" />

    <label>Title</label>
    <input asp-for="Title" class="form-control" required />
    <span asp-validation-for="Title" class="text-danger"></span>

    <label>Year</label>
    <input asp-for="Year" type="number" class="form-control" min="1888" max="2100" required />
    <span asp-validation-for="Year" class="text-danger"></span>

    <label>Director</label>
    <input asp-for="Director" class="form-control" required />
    <span asp-validation-for="Director" class="text-danger"></span>

    <label>Rating</label>
    <input asp-for="Rating" class="form-control" required />
    <span asp-validation-for="Rating" class="text-danger"></span>

    <!-- ✅ Fixed: Category Dropdown -->
    <label>Category</label>
    <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
        <option value="">Select a Category</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>

    <label>Edited</label>
    <select asp-for="Edited" class="form-control">
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <span asp-validation-for="Edited" class="text-danger"></span>

    <label>Copied to Plex</label>
    <select asp-for="CopiedToPlex" class="form-control">
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <span asp-validation-for="CopiedToPlex" class="text-danger"></span>

    <label>Notes</label>
    <textarea asp-for="Notes" class="form-control" maxlength="25"></textarea>
    <span asp-validation-for="Notes" class="text-danger"></span>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="ViewMovies" class="btn btn-secondary">Cancel</a>
</form>
